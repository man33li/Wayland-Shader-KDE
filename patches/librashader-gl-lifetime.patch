diff -ruN a/librashader-runtime-gl/src/gl/owned.rs b/librashader-runtime-gl/src/gl/owned.rs
--- a/librashader-runtime-gl/src/gl/owned.rs	1970-01-01 04:00:00.000000000 +0400
+++ b/librashader-runtime-gl/src/gl/owned.rs	2026-09-08 19:41:51.998572586 +0400
@@ -0,0 +1,58 @@
+use glow::HasContext;
+use std::sync::Arc;
+
+// Own allocations from one constructor, including its partially initialized
+// error paths. Raw handles in rendering structs are non-owning views. The
+// creating GL context must be current when this owner is dropped.
+pub(crate) struct GlObjects {
+    context: Arc<glow::Context>,
+    objects: Vec<GlObject>,
+}
+
+enum GlObject {
+    Buffer(glow::Buffer),
+    VertexArray(glow::VertexArray),
+    Texture(glow::Texture),
+    Sampler(glow::Sampler),
+    Program(glow::Program),
+    Shader(glow::Shader),
+}
+
+macro_rules! own {
+    ($method:ident, $kind:ident, $ty:ty) => {
+        pub(crate) fn $method(&mut self, handle: $ty) -> $ty {
+            self.objects.push(GlObject::$kind(handle));
+            handle
+        }
+    };
+}
+
+impl GlObjects {
+    pub(crate) fn new(context: &Arc<glow::Context>) -> Self {
+        Self { context: Arc::clone(context), objects: Vec::new() }
+    }
+
+    own!(buffer, Buffer, glow::Buffer);
+    own!(vertex_array, VertexArray, glow::VertexArray);
+    own!(texture, Texture, glow::Texture);
+    own!(sampler, Sampler, glow::Sampler);
+    own!(program, Program, glow::Program);
+    own!(shader, Shader, glow::Shader);
+}
+
+impl Drop for GlObjects {
+    fn drop(&mut self) {
+        for object in self.objects.drain(..).rev() {
+            unsafe {
+                match object {
+                    GlObject::Buffer(handle) => self.context.delete_buffer(handle),
+                    GlObject::VertexArray(handle) => self.context.delete_vertex_array(handle),
+                    GlObject::Texture(handle) => self.context.delete_texture(handle),
+                    GlObject::Sampler(handle) => self.context.delete_sampler(handle),
+                    GlObject::Program(handle) => self.context.delete_program(handle),
+                    GlObject::Shader(handle) => self.context.delete_shader(handle),
+                }
+            }
+        }
+    }
+}
